---
import { getSiteConfig } from '../../i18n/site';
import { useTranslations, otherLocale } from '../../i18n/utils';
import type { Locale } from '../../content.config';
import ThemeToggle from '../ui/ThemeToggle.astro';

export interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const siteConfig = getSiteConfig(lang);
const t = useTranslations(lang);
const other = otherLocale(lang);
const currentPath = Astro.url.pathname;
const homeUrl = `/${lang}/`;

const navItems = [
  { label: t('nav.notes'), href: `/${lang}/notes/` },
  { label: t('nav.blog'), href: `/${lang}/blog/` },
  { label: t('nav.docs'), href: `/${lang}/docs/` },
  { label: t('nav.search'), href: `/${lang}/search/` },
];
---

<header class="header">
  <nav class="header-nav">
    <!-- Logo — Fraunces -->
    <div class="logo">
      <a href={homeUrl}>{siteConfig.title}</a>
      <div class="logo-switches">
        <ThemeToggle />
      </div>
    </div>

    <!-- Hamburger toggle (visible on mobile) -->
    <button
      id="menu-toggle"
      class="menu-toggle"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <span class="menu-toggle-bar"></span>
      <span class="menu-toggle-bar"></span>
      <span class="menu-toggle-bar"></span>
    </button>

    <!-- Navigation Menu + Locale -->
    <div id="nav-right" class="nav-right">
      <ul id="menu" class="menu">
        {
          navItems.map(({ label, href }) => {
            const active = currentPath.startsWith(href);
            return (
              <li>
                <a href={href} class={active ? 'active' : ''}>
                  {label}
                </a>
              </li>
            );
          })
        }
      </ul>
      <a
        href={`/${other}/`}
        class="locale-switch"
        id="locale-switch"
        data-other-locale={other}
        aria-label={`Switch to ${other === 'zh' ? '中文' : 'English'}`}
      >
        {other === 'zh' ? '中文' : 'EN'}
      </a>
    </div>
  </nav>
</header>

<script>
  import { initLocaleSwitch } from '../../scripts/locale-switch';
  initLocaleSwitch();

  // Mobile menu toggle
  const toggle = document.getElementById('menu-toggle');
  const navRight = document.getElementById('nav-right');
  if (toggle && navRight) {
    toggle.addEventListener('click', () => {
      const open = navRight.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(open));
    });
  }
</script>
