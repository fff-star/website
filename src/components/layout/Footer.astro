---
import { getSiteConfig } from '../../i18n/site';
import type { Locale } from '../../content.config';

export interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const siteConfig = getSiteConfig(lang);
---

<footer class="footer">
  <div class="footer-inner">
    <span>&copy; {new Date().getFullYear()} {siteConfig.author}</span>
    <span class="footer-sep">&middot;</span>
    <span>
      <a
        href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
        target="_blank"
        rel="noopener noreferrer license"
      >
        CC BY-NC-SA 4.0
      </a>
    </span>
  </div>
</footer>

<!-- Scroll to top button -->
<button
  id="top-link"
  class="top-link hidden"
  aria-label="Scroll to top"
  title="Scroll to top"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <polyline points="18 15 12 9 6 15"></polyline>
  </svg>
</button>

<script>
  const topLink = document.getElementById('top-link');
  if (topLink) {
    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          if (window.scrollY > 400) {
            topLink.classList.remove('hidden');
          } else {
            topLink.classList.add('hidden');
          }
          ticking = false;
        });
        ticking = true;
      }
    });
    topLink.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>
