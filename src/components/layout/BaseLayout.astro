---
import { ClientRouter } from 'astro:transitions';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { getSiteConfig, SITE } from '../../i18n/site';
import { stripBold } from '../../lib/markdown';
import type { Locale } from '../../content.config';
import '../../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogType?: string;
  lang: Locale;
}

const {
  title,
  description: descProp,
  image = '/favicon.svg',
  ogType = 'website',
  lang,
} = Astro.props;

const siteConfig = getSiteConfig(lang);
const description = descProp ?? stripBold(siteConfig.description);
const pageTitle = title ? `${title} · ${siteConfig.title}` : siteConfig.title;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Preconnect to Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,9..144,400..650;1,9..144,400..650&family=Inter:ital,wght@0,400..650;1,400..650&display=swap" />

    <!-- Anti-flash: set theme before CSS loads -->
    <script is:inline>
      (function () {
        const theme = localStorage.getItem('pref-theme');
        if (theme === 'dark') {
          document.documentElement.dataset.theme = 'dark';
        } else if (theme === 'light') {
          document.documentElement.dataset.theme = 'light';
        } else if (
          window.matchMedia('(prefers-color-scheme: dark)').matches
        ) {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>

    <!-- Theme color for browser chrome -->
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#fafaf7"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#0a0a0a"
    />

    <!-- SEO -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={Astro.url} />
    {image && <meta property="og:image" content={image} />}

    <!-- View Transitions -->
    <ClientRouter />

    <!-- Canonical -->
    <link rel="canonical" href={new URL(Astro.url.pathname, SITE.url).href} />

    <!-- Styles handled by Astro CSS import -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <!-- Skip to content (a11y) -->
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Header {lang} />
    <main id="main-content" class="main">
      <slot />
    </main>
    <Footer {lang} />

    <!-- Copy button for code blocks -->
    <script>
      import { initCopyButtons } from '../../scripts/copy-code';
      initCopyButtons();
    </script>

    <!-- Watch for system theme changes -->
    <script>
      import { setTheme } from '../../scripts/theme';

      const mq = window.matchMedia('(prefers-color-scheme: dark)');
      mq.addEventListener('change', () => {
        if (!localStorage.getItem('pref-theme')) {
          setTheme(mq.matches ? 'dark' : 'light');
        }
      });
    </script>
  </body>
</html>
