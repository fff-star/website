---
import { buildGraph, buildFolderGraph, buildLocalGraph, type GraphData } from '../../lib/graph';
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../content.config';

interface Props {
  localSlug?: string;
  folder?: string;
  lang: Locale;
}

const { localSlug, folder, lang } = Astro.props;
const t = useTranslations(lang);

let graphData: GraphData;
if (localSlug) {
  graphData = await buildLocalGraph(localSlug, lang);
} else if (folder) {
  graphData = await buildFolderGraph(folder, lang);
} else {
  graphData = await buildGraph(lang);
}
---

<div
  id="graph-mount"
  class="graph-container"
  data-graph={JSON.stringify(graphData)}
>
  {
    graphData.nodes.length === 0 && (
      <div class="graph-fallback">
        {t('graph.no_connections')}
      </div>
    )
  }
</div>

<script>
  import('/src/components/graph/graph-loader.js').then(({ mountGraph }) => {
    const container = document.getElementById('graph-mount');
    if (container) mountGraph(container);
  });
</script>
