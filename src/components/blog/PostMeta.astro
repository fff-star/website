---
interface Props {
  date: Date;
  readingTime?: string;
  author?: string;
}

const { date, readingTime, author } = Astro.props;

function formatDate(d: Date): string {
  return d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<span>{formatDate(date)}</span>
{readingTime && <span>&nbsp;· {readingTime}</span>}
{author && <span>&nbsp;· {author}</span>}
