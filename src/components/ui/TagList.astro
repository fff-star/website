---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

<ul class="post-tags">
  {tags.length === 0 && <li class="empty-message" style="padding: 0; font-size: 13px;">No tags</li>}
  {
    tags.map((tag) => (
      <li>
        <a href={`/tags/${tag}/`}>{tag}</a>
      </li>
    ))
  }
</ul>
