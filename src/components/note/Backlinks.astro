---
import { getCollection } from 'astro:content';
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../content.config';

interface Props {
  currentSlug: string;
  lang: Locale;
}

const { currentSlug, lang } = Astro.props;
const t = useTranslations(lang);

// Build backlinks: find all notes that link to the current one
const allNotes = await getCollection('notes', ({ data }) => data.publish && !data.draft);
const backlinks = allNotes.filter((note) => {
  const content = note.body ?? '';
  // Match [[current-slug]] or [[current-slug|alias]]
  const pattern = new RegExp(
    `\\[\\[${currentSlug.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}(?:\\|[^\\]]+)?\\]\\]`,
    'i',
  );
  return pattern.test(content);
});
---

{
  backlinks.length > 0 && (
    <section class="backlinks">
      <h3>{t('notes.backlinks')}</h3>
      <p class="backlinks-desc">
        {t('notes.backlinks_count', { count: backlinks.length })}
      </p>
      <ul>
        {backlinks.map((note) => (
          <li>
            <a href={`/${lang}/notes/${note.id.replace(/\.md$/, '')}/`}>
              {note.data.title}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
