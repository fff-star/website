---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import { getCollection, getEntry, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import GithubSlugger from 'github-slugger';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
>
  <!-- Breadcrumbs -->
  <nav class="breadcrumbs">
    <a href="/blog/">Blog</a>
    <span>/</span>
    <span>{post.data.title}</span>
  </nav>

  <!-- Post Header -->
  <header class="post-header">
    <h1 class="post-title">{post.data.title}</h1>
  </header>

  <!-- Table of Contents -->
  {
    post.body && (
      <details class="toc toc-spaced">
        <summary>
          <span class="title">Table of Contents</span>
        </summary>
        <div class="inner">
          <nav>
            <ul>
              {
                (() => {
                  const slugger = new GithubSlugger();
                  return post.body
                    .split('\n')
                    .filter((l) => l.match(/^#{2,3}\s/))
                    .map((l) => {
                      const level = l.match(/^(#{2,3})/)?.[1].length ?? 2;
                      const text = l.replace(/^#{2,3}\s/, '');
                      const id = slugger.slug(text);
                      return { level, text, id };
                    })
                    .map(({ level, text, id }) => (
                      <li style={`--toc-depth: ${(level - 2) * 1.5}rem; margin-left: var(--toc-depth);`}>
                        <a href={`#${id}`}>{text}</a>
                      </li>
                    ));
                })()
              }
            </ul>
          </nav>
        </div>
      </details>
    )
  }

  <!-- Post Content -->
  <div class="post-content md-content">
    <Content />
  </div>

</BaseLayout>
