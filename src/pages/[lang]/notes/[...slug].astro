---
import BaseLayout from '../../../components/layout/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import GithubSlugger from 'github-slugger';
import { useTranslations } from '../../../i18n/utils';
import type { Locale } from '../../../content.config';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => data.publish && !data.draft);
  return notes.map((note) => ({
    params: {
      lang: note.id.split('/')[0],
      slug: note.id.replace(/\.md$/, '').split('/').slice(1).join('/'),
    },
    props: { note },
  }));
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);
const { note } = Astro.props;
const { Content } = await render(note);

// Resolve description from frontmatter
const description =
  note.data.description ??
  note.body?.split('\n').find((l) => l.trim() && !l.startsWith('#') && !l.startsWith('---'))?.slice(0, 200) ??
  '';
---

<BaseLayout
  lang={lang}
  title={note.data.title}
  description={description}
  ogType="article"
>
  <!-- Breadcrumbs -->
  <nav class="breadcrumbs">
    <a href={`/${lang}/notes/`}>{t('notes.breadcrumb')}</a>
    <span>/</span>
    <span>{note.data.title}</span>
  </nav>

  <!-- Post Header -->
  <header class="post-header">
    <h1 class="post-title">{note.data.title}</h1>
    <div class="post-meta post-meta-top">
      {note.data.date && (
        <span>
          {note.data.date.toLocaleDateString(lang === 'zh' ? 'zh-CN' : 'en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </span>
      )}
      {note.data.updated && (
        <span>
          &nbsp;· {t('post.updated')}{' '}
          {note.data.updated.toLocaleDateString(lang === 'zh' ? 'zh-CN' : 'en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </span>
      )}
    </div>
  </header>

  <!-- Table of Contents -->
  {
    note.body && (
      <details class="toc toc-spaced">
        <summary>
          <span class="title">{t('post.toc')}</span>
        </summary>
        <div class="inner">
          <nav>
            <ul>
              {
                (() => {
                  const slugger = new GithubSlugger();
                  return note.body
                    .split('\n')
                    .filter((l) => l.match(/^#{1,3}\s/))
                    .map((l) => {
                      const level = l.match(/^(#{1,3})/)?.[1].length ?? 1;
                      const text = l.replace(/^#{1,3}\s/, '');
                      const id = slugger.slug(text);
                      return { level, text, id };
                    })
                    .map(({ level, text, id }) => (
                      <li style={`--toc-depth: ${(level - 1) * 1.5}rem; margin-left: var(--toc-depth);`}>
                        <a href={`#${id}`}>{text}</a>
                      </li>
                    ));
                })()
              }
            </ul>
          </nav>
        </div>
      </details>
    )
  }

  <!-- Post Content -->
  <div class="post-content md-content">
    <Content />
  </div>
</BaseLayout>
