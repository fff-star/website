---
import BaseLayout from '../../../components/layout/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { useTranslations } from '../../../i18n/utils';
import type { Locale } from '../../../content.config';
import TableOfContents from '../../../components/ui/TableOfContents.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => data.publish && !data.draft);
  return notes.map((note) => ({
    params: {
      lang: note.id.split('/')[0],
      slug: note.id.replace(/\.md$/, '').split('/').slice(1).join('/'),
    },
    props: { note },
  }));
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);
const { note } = Astro.props;
const { Content, headings } = await render(note);

// Resolve description from frontmatter
const description =
  note.data.description ??
  note.body?.split('\n').find((l) => l.trim() && !l.startsWith('#') && !l.startsWith('---'))?.slice(0, 200) ??
  '';
---

<BaseLayout
  lang={lang}
  title={note.data.title}
  description={description}
  ogType="article"
>
  <!-- Breadcrumbs -->
  <nav class="breadcrumbs">
    <a href={`/${lang}/notes/`}>{t('notes.breadcrumb')}</a>
    <span>/</span>
    <span>{note.data.title}</span>
  </nav>

  <!-- Post Header -->
  <header class="post-header">
    <h1 class="post-title">{note.data.title}</h1>
    <div class="post-meta post-meta-top">
      {note.data.date && (
        <span>
          {note.data.date.toLocaleDateString(lang === 'zh' ? 'zh-CN' : 'en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </span>
      )}
      {note.data.updated && (
        <span>
          &nbsp;· {t('post.updated')}{' '}
          {note.data.updated.toLocaleDateString(lang === 'zh' ? 'zh-CN' : 'en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </span>
      )}
    </div>
  </header>

  <!-- Table of Contents -->
  <TableOfContents headings={headings} title={t('post.toc')} minDepth={1} maxDepth={3} />

  <!-- Post Content -->
  <div class="post-content md-content">
    <Content />
  </div>
</BaseLayout>
