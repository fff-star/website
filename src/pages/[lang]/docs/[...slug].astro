---
import BaseLayout from '../../../components/layout/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { useTranslations } from '../../../i18n/utils';
import type { Locale } from '../../../content.config';
import TableOfContents from '../../../components/ui/TableOfContents.astro';

export async function getStaticPaths() {
  const posts = await getCollection('docs', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: {
      lang: post.id.split('/')[0],
      slug: post.id.replace(/\.md$/, '').split('/').slice(1).join('/'),
    },
    props: { post },
  }));
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);
const { post } = Astro.props;
const { Content, headings } = await render(post);
---

<BaseLayout
  lang={lang}
  title={post.data.title}
  description={post.data.description}
  ogType="article"
>
  <!-- Breadcrumbs -->
  <nav class="breadcrumbs">
    <a href={`/${lang}/docs/`}>{t('docs.title')}</a>
    <span>/</span>
    <span>{post.data.title}</span>
  </nav>

  <!-- Post Header -->
  <header class="post-header">
    <h1 class="post-title">{post.data.title}</h1>
  </header>

  <!-- Table of Contents -->
  <TableOfContents headings={headings} title={t('post.toc')} minDepth={2} />

  <!-- Post Content -->
  <div class="post-content md-content">
    <Content />
  </div>
</BaseLayout>
