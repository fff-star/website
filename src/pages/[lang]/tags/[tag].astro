---
import BaseLayout from '../../../components/layout/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../../i18n/utils';
import type { Locale } from '../../../content.config';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const seen = new Set<string>();
  const paths: { params: { lang: string; tag: string } }[] = [];
  for (const post of posts) {
    const lang = post.id.split('/')[0];
    for (const tag of post.data.tags) {
      const t = String(tag);
      if (t && !t.includes('/')) {
        const key = `${lang}:${t}`;
        if (!seen.has(key)) {
          seen.add(key);
          paths.push({ params: { lang, tag: t } });
        }
      }
    }
  }
  return paths;
}

const { lang, tag } = Astro.params as { lang: Locale; tag: string };
const t = useTranslations(lang);

const posts = await getCollection('blog', ({ data, id }) =>
  !data.draft
  && id.startsWith(`${lang}/`)
  && data.tags.map(String).includes(tag),
);
const sorted = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout lang={lang} title={`#${tag}`}>
  <header class="page-header">
    <h1>#{tag}</h1>
  </header>

  {sorted.length === 0 && <p>{t('tags.no_posts')}</p>}

  {sorted.map((post) => {
    const slug = post.id.replace(/\.md$/, '').split('/').slice(1).join('/');
    return (
      <div class="tag-post-item">
        <span class="tag-post-date">
          {post.data.date.toLocaleDateString(lang === 'zh' ? 'zh-CN' : 'en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
        </span>
        <a href={`/${lang}/blog/${slug}/`}>
          {post.data.title}
        </a>
      </div>
    );
  })}

  <a href={`/${lang}/tags/`} class="tag-back-link">{t('tags.back')}</a>
</BaseLayout>
