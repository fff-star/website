---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import GraphIsland from '../../components/graph/GraphIsland.astro';
import { getFolders, buildFolderGraph } from '../../lib/graph';

const folders = await getFolders();
const defaultFolder = Astro.url.searchParams.get('folder') ?? folders[0] ?? '';

const graphData = await buildFolderGraph(defaultFolder);
---

<BaseLayout title="Knowledge Graph">
  <header class="page-header">
    <h1>Knowledge Graph</h1>
  </header>
  <p class="graph-folder-label" style="margin-bottom: var(--gap);">
    Each folder is a self-contained knowledge domain.
    Nodes = notes, lines = wiki-links within the folder.
    <strong>Drag</strong> to rearrange, <strong>scroll</strong> to zoom,
    <strong>click</strong> to navigate.
  </p>

  <!-- Folder selector -->
  {
    folders.length > 1 && (
      <nav class="graph-folder-nav">
        {folders.map((f) => (
          <a
            href={`/notes/graph/?folder=${f}`}
            class="graph-folder-chip"
            data-active={f === defaultFolder ? 'true' : 'false'}
          >
            {f}/
          </a>
        ))}
      </nav>
    )
  }

  <!-- Per-folder stats -->
  <div class="graph-folder-info">
    <p class="graph-folder-label">
      Folder: <strong>{defaultFolder}/</strong>
      · {graphData.nodes.length} notes · {graphData.links.length} connections
    </p>
  </div>

  <GraphIsland folder={defaultFolder} />
</BaseLayout>
