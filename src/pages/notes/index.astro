---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import { getCollection } from 'astro:content';

const notes = await getCollection('notes', ({ data }) => data.publish && !data.draft);

// Find folders: notes whose ids contain a slash
const folderSet = new Set<string>();

for (const note of notes) {
  const id = note.id.replace(/\.md$/, '');
  if (id.includes('/')) {
    folderSet.add(id.slice(0, id.indexOf('/')));
  }
}

const folders = [...folderSet].sort();
---

<BaseLayout title="Notes">
  <header class="page-header">
    <h1>Notes</h1>
  </header>

  {notes.length === 0 && <p>No notes published yet.</p>}

  {folders.map((folder) => {
    const count = notes.filter((n) => {
      const id = n.id.replace(/\.md$/, '');
      return id.startsWith(folder + '/');
    }).length;
    return (
      <div class="folder-item">
        <a href={`/notes/${folder}/`}>{folder}/</a>
        <span class="count">{count} notes</span>
        <a
          href={`/notes/graph/?folder=${folder}`}
          class="graph-link"
        >
          Graph →
        </a>
      </div>
    );
  })}
</BaseLayout>
