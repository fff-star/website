---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import TagList from '../../components/ui/TagList.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({
    params: { slug: note.id.replace(/\.md$/, '') },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);

// Resolve description from frontmatter
const description =
  note.data.description ??
  note.body?.split('\n').find((l) => l.trim() && !l.startsWith('#') && !l.startsWith('---'))?.slice(0, 200) ??
  '';
---

<BaseLayout
  title={note.data.title}
  description={description}
  ogType="article"
>
  <!-- Breadcrumbs -->
  <nav class="breadcrumbs">
    <a href="/notes/">Notes</a>
    <span>/</span>
    <span>{note.data.title}</span>
  </nav>

  <!-- Post Header -->
  <header class="post-header">
    <h1 class="post-title">{note.data.title}</h1>
    {description && <div class="post-description">{description}</div>}
    <div class="post-meta">
      {note.data.date && (
        <span>
          {note.data.date.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </span>
      )}
      {note.data.updated && (
        <span class="text-secondary">
          &nbsp;· Updated{' '}
          {note.data.updated.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </span>
      )}
    </div>

    <!-- Tags -->
    {
      note.data.tags.length > 0 && (
        <div class="post-tags" style="margin-top: 8px; font-size: 16px; color: var(--secondary);">
          Tags: {note.data.tags.map((tag, i) => (
            <><a href={`/tags/${tag}/`}>{tag}</a>{i < note.data.tags.length - 1 ? ', ' : ''}</>
          ))}
        </div>
      )
    }
  </header>

  <!-- Table of Contents -->
  <details class="toc">
    <summary>
      <span class="title">Table of Contents</span>
    </summary>
    <div class="inner">
      <nav>
        <ul>
          {
            // Extract headings from content for TOC
            note.body
              ?.split('\n')
              .filter((l) => l.match(/^#{1,3}\s/))
              .map((l) => {
                const level = l.match(/^(#{1,3})/)?.[1].length ?? 1;
                const text = l.replace(/^#{1,3}\s/, '');
                const id = text.toLowerCase().replace(/[^\w]+/g, '-');
                return { level, text, id };
              })
              .map(({ level, text, id }) => (
                <li style={`margin-left: ${(level - 1) * 1.5}rem;`}>
                  <a href={`#${id}`}>{text}</a>
                </li>
              ))
          }
        </ul>
      </nav>
    </div>
  </details>

  <!-- Post Content -->
  <div class="post-content md-content">
    <Content />
  </div>

  <!-- Post Navigation (Prev/Next) -->
  {
    false
      /* TODO: Implement prev/next navigation */
  }
</BaseLayout>
